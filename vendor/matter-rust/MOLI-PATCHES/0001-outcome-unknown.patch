From 0c332883250fb447af72e1c4c4316df6f55bdb6c Mon Sep 17 00:00:00 2001
From: series <series@local>
Date: Fri, 13 Nov 2026 12:49:09 +0100
Subject: [PATCH] fix(controller): report an unknown outcome when the deadline
 fires after queueing

`write_before`/`invoke_before` returned a plain `Operational` error both
when the request never reached the queue and when it was queued but answered
too late. The second case is not a failure: the device may have carried the
order out (a lock, a cover). Add `Error::OutcomeUnknown` and keep
`Operational` for the request that was never sent.
---
 .../crates/matter-controller/src/actor.rs     |   8 +-
 .../crates/matter-controller/src/error.rs     |  18 ++
 .../crates/matter-controller/src/node.rs      | 176 ++++++++++++------
 3 files changed, 146 insertions(+), 56 deletions(-)

diff --git a/crates/matter-controller/src/actor.rs b/crates/matter-controller/src/actor.rs
index 4debaf6..49f04aa 100644
--- a/crates/matter-controller/src/actor.rs
+++ b/crates/matter-controller/src/actor.rs
@@ -23610,7 +23610,13 @@ mod tests {
                     task.abort();
                     assert!(task.await.unwrap_err().is_cancelled());
                 } else {
-                    assert!(matches!(task.await.unwrap(), Err(Error::Operational(_))));
+                    // The command reached the queue before the deadline, so the
+                    // outcome is unknown rather than a plain failure: the actor
+                    // may already have transmitted it.
+                    assert!(matches!(
+                        task.await.unwrap(),
+                        Err(Error::OutcomeUnknown { node_id: 0x42 })
+                    ));
                 }
                 let mut w = wired_actor();
                 w.actor.dispatch(cmd).await;
diff --git a/crates/matter-controller/src/error.rs b/crates/matter-controller/src/error.rs
index 179a43b..9507ced 100644
--- a/crates/matter-controller/src/error.rs
+++ b/crates/matter-controller/src/error.rs
@@ -83,6 +83,24 @@ pub enum Error {
         after: std::time::Duration,
     },
 
+    /// A caller-supplied deadline elapsed after the request had been handed to
+    /// the controller task, so it may or may not have reached the device. For a
+    /// non-idempotent command (a lock, a cover) the result is unknown, not
+    /// failed: the device may have carried it out and answered too late.
+    ///
+    /// Never retried automatically, for the same reason as
+    /// [`Self::ResponseTimeout`]. Distinct from it on purpose: that one means
+    /// MRP confirmed delivery, this one means we cannot say whether anything
+    /// was transmitted at all (the request may still have been queued).
+    #[error(
+        "node {node_id:016X}: deadline elapsed after the request was queued — it may have \
+         been sent and carried out, and its outcome is unknown"
+    )]
+    OutcomeUnknown {
+        /// The node the request targeted.
+        node_id: u64,
+    },
+
     /// The device rejected a subscribe request with an Interaction Model status
     /// code (e.g. 0x89 `ResourceExhausted` when its subscription resources are
     /// full, 0xC8 `PathsExhausted` when a path quota is exceeded, 0x80
